pipeline {
    agent any
    environment {
        AWS_REGION = 'ap-south-1'
        ECR_REPO = 'aws-devsecops-demo'
        IMAGE_TAG = "${BUILD_NUMBER}"
        SONARQUBE_SERVER = 'sonarqube'
    }
    stages {
        stage('Checkout') { steps { checkout scm } }

        stage('Code Quality') {
            steps {
                sh '''
                  echo "Run SonarQube scanner here. Configure a Jenkins SonarQube server named ${SONARQUBE_SERVER}."
                  test -f application/index.html
                '''
            }
        }

        stage('Security Scan') {
            steps {
                sh 'chmod +x security/security-scan.sh && ./security/security-scan.sh'
            }
        }

        stage('Build Docker Image') {
            steps { sh 'docker build -t ${ECR_REPO}:${IMAGE_TAG} -f docker/Dockerfile .' }
        }

        stage('Container Test') {
            steps {
                sh 'docker run -d --name devsecops-test ${ECR_REPO}:${IMAGE_TAG}'
                sh 'sleep 3'
                sh 'docker exec devsecops-test wget -qO- http://localhost/ | grep "AWS DevSecOps Pipeline"'
            }
            post { always { sh 'docker rm -f devsecops-test || true' } }
        }

        stage('Push ECR') {
            steps {
                sh '''
                  ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)
                  REGISTRY=${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
                  aws ecr describe-repositories --repository-names ${ECR_REPO} --region ${AWS_REGION} >/dev/null 2>&1 || aws ecr create-repository --repository-name ${ECR_REPO} --region ${AWS_REGION}
                  aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${REGISTRY}
                  docker tag ${ECR_REPO}:${IMAGE_TAG} ${REGISTRY}/${ECR_REPO}:${IMAGE_TAG}
                  docker push ${REGISTRY}/${ECR_REPO}:${IMAGE_TAG}
                '''
            }
        }

        stage('Terraform Validate') {
            steps {
                dir('terraform') {
                    sh 'terraform init -backend=false'
                    sh 'terraform validate'
                }
            }
        }

        stage('Deploy with Ansible') {
            steps {
                sh 'echo "Run ansible-playbook after configuring a secure inventory and SSH credential."'
            }
        }
    }
    post {
        always { sh 'docker rm -f devsecops-test || true' }
    }
}
